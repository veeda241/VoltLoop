# Demo mode works without these. Copy to .env.local if you need overrides.

# Shared HMAC key for ESP-NOW hop verification (rotate in production)
VITE_VOLTLOOP_HMAC_KEY=voltloop-demo-hmac-key-2026
VOLTLOOP_HMAC_KEY=voltloop-demo-hmac-key-2026

# Optional Next.js API + Supabase (npm run dev:api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Open Charge Map (optional — seed + India catalog work without it)
# https://openchargemap.org/site/develop/api
OCM_API_KEY=
